FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04

RUN apt-get update && apt-get install -y \
    curl build-essential python3 python3-pip pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip3 install -r /tmp/requirements.txt --break-system-packages

# Pinned to match rust-toolchain.toml so the image ships the toolchain the
# build actually uses — otherwise rustup honours the pin by DOWNLOADING it
# on first cargo invocation, inside every job.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
      --default-toolchain 1.89.0
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
